{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "quizie-flashcards",
	"main": "src/index.js",
	"compatibility_date": "2026-08-13",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{
			"pattern": "quizie-flashcard.fancyapps.dev",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"kv_namespaces": [
		{
			"binding": "HANDBOOK_INDEX_STATE",
			"id": "a7c39f6d2d5d4f3aa42b55c381179280"
		}
	],
	"vars": {
		"OPENAI_MODEL": "gpt-5.6-luna",
		"HANDBOOK_VECTOR_STORE_ID": "vs_6a7cfe208df08191ac45f27c0f506e14"
	}
}